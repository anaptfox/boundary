  "hostcallCopyBudget": {
    "$comment": "One law, two hosts. A guest may copy at most `limit` bytes across host imports per invocation: the UTF-8 byte length of every request it sends plus every reply or declared error the host returns, summed; equality is allowed. Startup and every call each get a separate full budget (Rust GuestLimits.hostcall_copy_bytes, Node hostcallCopyBytes), so the budget is per invocation, not per instance lifetime. A request that would pass the limit is refused before the host function runs. A reply that would pass it is withheld from the guest after the host ran. Both fault with certainty unknown, never a declared error and never not-started: the guest was already running and a withheld reply follows a host effect that may have happened. HostReply::Unknown and thrown host errors carry no copied payload and are not counted. The import-call fixture sends a 16-byte request and returns whatever the host replies. `outcomes` lists the admission outcome alone when admission fails, otherwise one outcome per call.",
    "requestBytes": 16,
    "default": 134217728,
    "cases": [
      {"name": "an-exactly-equal-budget-completes", "fixture": "import-call", "limit": 18, "replyKind": "ok", "reply": "{}", "lifetime": "per-call", "calls": 1, "outcomes": ["completed"], "hostCalls": 1},
      {"name": "a-reply-one-byte-over-is-withheld-after-the-host-ran", "fixture": "import-call", "limit": 17, "replyKind": "ok", "reply": "{}", "lifetime": "per-call", "calls": 1, "outcomes": ["unknown"], "hostCalls": 1},
      {"name": "a-request-over-budget-never-reaches-the-host", "fixture": "import-call", "limit": 15, "replyKind": "ok", "reply": "{}", "lifetime": "per-call", "calls": 1, "outcomes": ["unknown"], "hostCalls": 0},
      {"name": "utf8-bytes-not-characters-are-counted-for-a-reply-at-the-limit", "fixture": "import-call", "limit": 24, "replyKind": "ok", "reply": "éééé", "lifetime": "per-call", "calls": 1, "outcomes": ["completed"], "hostCalls": 1},
      {"name": "utf8-bytes-not-characters-are-counted-for-a-reply-over-the-limit", "fixture": "import-call", "limit": 23, "replyKind": "ok", "reply": "éééé", "lifetime": "per-call", "calls": 1, "outcomes": ["unknown"], "hostCalls": 1},
      {"name": "a-declared-error-reply-is-counted-at-the-limit", "fixture": "import-call", "limit": 24, "replyKind": "err", "reply": "éééé", "lifetime": "per-call", "calls": 1, "outcomes": ["declared-error"], "hostCalls": 1},
