      {"name": "the-budget-is-per-invocation-not-per-instance", "fixture": "import-call", "limit": 18, "replyKind": "ok", "reply": "{}", "lifetime": "persistent", "calls": 2, "outcomes": ["completed", "completed"], "hostCalls": 2},
