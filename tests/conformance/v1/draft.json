{
  "version": 1,
  "$comment": "Reviewed evidence for the interaction Draft. 'Proposal' already names Control's pending effect, so a contract that does not exist yet gets its own word: Draft. A Draft wraps a FULL interaction contract -- the entire declared identity, never a fragment, because anything less forks contract identity, which is the whole thing to avoid -- plus gap (free text explaining what is missing), proposer (an opaque host-supplied string), and createdAt (a host-supplied ISO-8601 timestamp; Boundary never reads a clock internally). Digests are computed over boundary.interaction-draft/v1 with canonical JSON, hashing { version, contract, gap, proposer, createdAt } where contract is the contract's own canonical identity value. A Draft is not a Program entry and is never callable: it is an inert artifact a person reviews. A gate may verify these vectors but must never rewrite them.",
  "domain": "boundary.interaction-draft/v1",
  "cases": [
    {
      "name": "todos-archive",
      "input": {
        "contract": {
          "version": 1,
          "id": "todos.archive",
          "inputSchema": {
            "type": "object",
            "properties": { "id": { "type": "string" } },
            "required": ["id"],
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "archivedAt": { "type": "string" }
            },
            "required": ["id", "archivedAt"],
            "additionalProperties": false
          },
          "reads": ["todos"],
          "changes": ["todos"]
        },
        "gap": "Only delete exists today; archive would keep history instead of removing the row.",
        "proposer": "agent:catalog-bot",
        "createdAt": "2026-09-06T12:00:00Z"
      },
      "expected": {
        "draftDigest": "sha256:9484d7924a2ee37c5bff19c8470f637ec04ed43d37146347e21d79f1dde75e95"
      }
    },
