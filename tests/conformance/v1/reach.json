        "bindingDigest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "installationId": "deploy:example:1",
        "transports": [
          {
            "base": "/boundary/v1",
            "kind": "unix",
            "path": "/tmp/boundary.sock"
          }
        ]
      },
      "name": "unix-only"
    },
